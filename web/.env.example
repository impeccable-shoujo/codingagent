# 前端环境变量模板
#
# 用法：复制成 .env（同样被 .gitignore 忽略）
#   cp .env.example .env
#
# 注意：Vite 只会把 VITE_ 前缀的变量注入前端代码，所以这里的变量都不是密钥。
# 密钥永远只存在于后端 .env，不要放进这个文件。

# API 基地址。
# 留空或设为 /api 时走 Vite 开发代理（推荐，前后端同源，不涉及 CORS）；
# 设成绝对地址则直连后端，此时需要后端 AGENT_CORS_ORIGINS 放行本前端来源。
VITE_API_BASE_URL=/api

# 开发代理的目标，即 FastAPI 传输层地址
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# 开发服务器端口。改这里的话记得同步后端 AGENT_CORS_ORIGINS
VITE_DEV_PORT=5173
