# 环境变量模板
#
# 用法：复制成 .env 后按需修改
#   cp .env.example .env
#
# .env 已在 .gitignore 中，密钥不会被提交。
# 优先级：命令行参数 > 真实环境变量 > .env 文件 > 代码默认值

# ---------- 模型 ----------
# 必须选支持 function calling 的模型，否则 agent 无法调用工具。
# 智谱当前可用：glm-4.5 / glm-4.5-air / glm-4.6 / glm-4.7 /
#              glm-5 / glm-5-turbo / glm-5.1 / glm-5.2 / glm-5.3 / glm-5.3-flash
AGENT_MODEL=glm-4.5-air
AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT_TEMPERATURE=0.0

# ---------- 密钥（二选一，方式一优先）----------
# 方式一：密钥直接写在 .env 里，适合本地开发
AGENT_API_KEY=
# 方式二：此处只写"存放密钥的环境变量名"，密钥本身放系统环境变量里
AGENT_API_KEY_ENV=ZHIPU_API_KEY

# ---------- 循环控制 ----------
# 最大迭代轮数，防止 agent 卡在死循环里烧 token
AGENT_MAX_ITERATIONS=25
# 连续工具调用失败多少次后熔断退出
AGENT_MAX_CONSECUTIVE_FAILURES=3

# ---------- 工具与输出 ----------
# 单条命令超时秒数（上限 300）
AGENT_COMMAND_TIMEOUT=60
# 工具输出超过多少字符 / 行数就截断，防止撑爆上下文
AGENT_MAX_OUTPUT_CHARS=10000
AGENT_MAX_OUTPUT_LINES=200

# ---------- 路径 ----------
AGENT_WORKSPACE=.
AGENT_LOG_DIR=runs

# ---------- 审批 ----------
# true 时自动批准 rm / git 写操作 / 安装依赖等需确认命令（危险，仅限可信环境）
AGENT_AUTO_APPROVE=false
